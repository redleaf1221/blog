<%
  var ownTitle = tab_title();
  var pageTitle = ownTitle && ownTitle !== config.title ? ownTitle + ' · ' + config.title : config.title;
  var pageDesc = page.description || config.description || '';
  var pageType = page.layout === 'post' ? 'article' : 'website';
%>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= pageTitle %></title>
<% if (pageDesc) { %><meta name="description" content="<%= pageDesc %>"><% } %>
<meta name="theme-color" content="#0b0d10">
<link rel="canonical" href="<%- full_url_for(page.path || '') %>">
<meta property="og:type" content="<%= pageType %>">
<meta property="og:title" content="<%= pageTitle %>">
<meta property="og:site_name" content="<%= config.title %>">
<meta property="og:url" content="<%- full_url_for(page.path || '') %>">
<% if (pageType === 'article' && page.date) { %><meta property="article:published_time" content="<%= page.date.toISOString() %>"><% } %>
<link rel="icon" href="<%- url_for('/images/favicon.svg') %>" type="image/svg+xml">
<link rel="stylesheet" href="<%- url_for('/css/term.css') %>">
<style>:root{--accent: <%= theme.accent || '#5ad1c8' %>;}</style>
<script>
  (function () {
    try {
      var stored = window.localStorage.getItem('term-theme');
      var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
      document.documentElement.setAttribute('data-theme', stored || (prefersLight ? 'light' : 'dark'));
    } catch (e) { /* no-op */ }
  })();
</script>
<%- meta_generator() %>
