<header class="topbar">
  <div class="topbar-left">
    <button class="icon-btn sidebar-toggle" type="button" data-sidebar-toggle aria-label="<%= __('sidebar.all') %>" aria-expanded="false">
      <%- partial('_partial/icon', { name: 'menu' }) %>
    </button>

    <a class="brand" href="<%- url_for('/') %>">
      <% if (theme.avatar) { %>
      <img class="brand-avatar" src="<%= theme.avatar %>" alt="" width="30" height="30" loading="lazy">
      <% } else { %>
      <span class="brand-avatar is-letter" aria-hidden="true"><%= String(config.author || config.title || 'T').slice(0, 1).toUpperCase() %></span>
      <% } %>
      <span class="brand-name"><%= theme.brand_name || config.title %></span>
    </a>

    <nav class="site-nav" data-nav>
      <% Object.keys(theme.menu || {}).forEach(function (key) { var href = theme.menu[key]; %>
      <a class="nav-link<%= nav_active(key) ? ' is-active' : '' %>" href="<%- url_for(href) %>" data-nav-key="<%= key %>">
        <%- partial('_partial/icon', { name: key }) %>
        <span class="nav-text"><%= __('menu.' + key) %></span>
      </a>
      <% }); %>
    </nav>
  </div>

  <div class="topbar-right">
    <% if (theme.social && theme.social.github) { %>
    <a class="icon-btn" href="<%= theme.social.github %>" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 22v-4a4 4 0 0 0-1.2-3.1c3.9-.4 5.2-2.6 5.2-5.6a5.5 5.5 0 0 0-1.5-3.8 4.7 4.7 0 0 0-.1-3.6s-1.1-.3-3.6 1.3a13 13 0 0 0-6.6 0C4.7 1.6 3.6 1.9 3.6 1.9a4.7 4.7 0 0 0-.1 3.6A5.5 5.5 0 0 0 2 9.3c0 3 1.3 5.2 5.2 5.6A4 4 0 0 0 6 17.7V22"/><path d="M9 19c-2.5.8-3-1.5-4.5-2"/></svg>
    </a>
    <% } %>
    <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle theme">
      <%- partial('_partial/icon', { name: 'sun' }) %>
      <%- partial('_partial/icon', { name: 'moon' }) %>
    </button>
  </div>
</header>
